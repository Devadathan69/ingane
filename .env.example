# Copy to .env (never commit .env). Keys stay server-side; never prefix secrets with VITE_.
OPENAI_API_KEY=
# Image-capable model used for the vision and planning passes.
OPENAI_MODEL=gpt-5.5
SARVAM_API_KEY=
# Speech-to-text model (Saaras).
SARVAM_STT_MODEL=saaras:v4
# Narration (Bulbul). Defaults to bulbul:v3 + shubh; change only after verifying clips with scripts/verify-voices.ts.
SARVAM_TTS_MODEL_ML=bulbul:v3
SARVAM_TTS_SPEAKER_ML=shubh
SARVAM_TTS_MODEL_EN=bulbul:v3
SARVAM_TTS_SPEAKER_EN=shubh
# live (default) or mock (demo data, no provider calls).
INGANE_PROVIDER=live
# Optional: stable secret for signing narration requests (random per process if unset).
NARRATION_SECRET=
PORT=8787
REQUEST_TIMEOUT_MS=60000
OPENAI_TIMEOUT_MS=45000
SARVAM_TIMEOUT_MS=20000
# Set to 1 only behind a trusted reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=0
# Optional Family Guides authentication and persistent private SQLite storage.
# INGANE_FAMILY_CREATORS is a JSON object mapping each creator ID to the SHA-256 hex digest
# of a random 32-byte base64url creator key. See README for local PowerShell setup.
# INGANE_FAMILY_CREATORS=
# INGANE_FAMILY_PRIVATE_DIR=.ingane-private
