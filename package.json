{
  "name": "ingane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:hosted": "node scripts/build-hosted.mjs",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "check:guide-languages": "node --env-file-if-exists=.env --import tsx scripts/check-guide-languages.mjs",
    "check:openai": "tsx --env-file-if-exists=.env scripts/check-openai.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build && vite build --ssr server/index.ts --outDir build/server --emptyOutDir",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "e2e": "node scripts/e2e-check.mjs",
    "e2e:v2": "node scripts/e2e-v2.mjs",
    "e2e:v3": "node scripts/e2e-v3.mjs",
    "e2e:v4": "node scripts/e2e-family.mjs",
    "e2e:press": "node scripts/e2e-press.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "hono": "^4.13.18",
    "openai": "^7.57.0",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sarvamai": "^1.1.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
